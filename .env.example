# Copy to .env and fill in. Never commit .env.

# Supabase session pooler connection string (Project Settings -> Database ->
# Connection string -> Session pooler). The direct db.<ref>.supabase.co host is
# IPv6-only and unreachable from Render.
# Format: postgresql+psycopg://postgres.<project-ref>:<password>@aws-<n>-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Timezone used for "today" (default date and the no-future-date rule).
APP_TIMEZONE=Asia/Kolkata

# Tests reuse DATABASE_URL but run in an isolated `test` schema (see tests/conftest.py);
# public.expenses is never touched by the test suite.
